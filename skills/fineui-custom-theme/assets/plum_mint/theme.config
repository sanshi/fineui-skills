# 暮紫薄荷：深梅紫内容区、薄荷绿强调色、浅紫白文字。
# 注释单独占一行；颜色值后面不要追加说明。

# 六组基础状态：内容、标题、默认、悬停、选中、错误。
content-border-color = #594765
content-background-color = #241c2e
content-text-color = #f0e8f5
header-border-color = #594765
header-background-color = #34273f
header-text-color = #f0e8f5
default-border-color = #756383
default-background-color = #30253b
default-text-color = #f0e8f5
hover-border-color = #b5efcf
hover-background-color = #45344f
hover-text-color = #d0f7e0
active-border-color = #b5efcf
active-background-color = #b5efcf
active-text-color = #241c2e
error-border-color = #f29baf
error-background-color = #472b3c
error-text-color = #ffc1d0
border-radius = 10px

# 内容底色深；选中时切换为亮底深字，属于强调式选中态。
is-dark-background = true
is-dark-active-color = true

# 主按钮使用亮底深字，与普通按钮区分。
primary-background-color = #b5efcf
primary-text-color = #241c2e
tabstrip-inkbar-color = #b5efcf
focus-shadow-alpha = .4

# 标题栏工具的悬停与选中状态。
header-hover-border-color = #b5efcf
header-hover-background-color = #45344f
header-hover-text-color = #d0f7e0
header-active-border-color = #b5efcf
header-active-background-color = #b5efcf
header-active-text-color = #241c2e

# 示例首页外框使用更深的梅紫色，保持导航与内容的层次。
index-header-border-color = #594765
index-header-background-color = #1b1424
index-header-text-color = #f0e8f5
index-hover-border-color = #b5efcf
index-hover-background-color = #45344f
index-hover-text-color = #d0f7e0
index-active-border-color = #b5efcf
index-active-background-color = #b5efcf
index-active-text-color = #241c2e
